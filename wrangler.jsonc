{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentwire",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f796e83dc0009a24dadf3f5016b8a1ff",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
