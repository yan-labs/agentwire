// Local-dev only: the bundled workerd predates `exports` and 2026-10 compat dates.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentwire",
  "main": "../src/index.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f796e83dc0009a24dadf3f5016b8a1ff",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "DIRECTORY",
        "class_name": "Directory"
      }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }],
  "observability": {
    "enabled": true
  }
}
