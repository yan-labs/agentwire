{
  "name": "agents-hot-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agents Hot website, docs and web console (static, built with Astro)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check-dist.mjs",
