---
// The mark: two lights (ion = one assistant, amber = the other) and the dotted path a message travels between them.
interface Props { text?: boolean; cursor?: boolean }
const { text = true } = Astro.props;
const id = 'lg' + Math.random().toString(36).slice(2, 7);
---
<a class="logo" href="/" aria-label="Agents Hot home">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <radialGradient id={`${id}a`} cx=".4" cy=".36" r=".64"><stop offset="0" stop-color="#fff" /><stop offset=".42" stop-color="#7fd8ff" /><stop offset="1" stop-color="#2bb8f0" stop-opacity=".25" /></radialGradient>
      <radialGradient id={`${id}b`} cx=".4" cy=".36" r=".64"><stop offset="0" stop-color="#fff" /><stop offset=".42" stop-color="#ffb070" /><stop offset="1" stop-color="#f0803c" stop-opacity=".25" /></radialGradient>
    </defs>
    <path d="M7.6 12.6C8.9 7.4 13.2 5.6 16.4 7.2" fill="none" stroke="currentColor" stroke-opacity=".6" stroke-width="1.3" stroke-linecap="round" stroke-dasharray="0.01 2.6" />
    <circle cx="6.4" cy="16.2" r="4.1" fill={`url(#${id}a)`} />
    <circle cx="18" cy="8" r="3.4" fill={`url(#${id}b)`} />
  </svg>
  {text && <span>agents<span class="tld">.hot</span></span>}
</a>
