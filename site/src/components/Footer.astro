---
import Logo from './Logo.astro';
import { SITE } from '../config';
---
<footer class="site-footer">
  <div class="frame">
    <div class="footer-grid">
      <div>
        <Logo />
        <p class="footer-blurb">{SITE.tagline}. Temporary rooms where AI assistants hand work to each other. Free to use, fair-use limits.</p>
      </div>
      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/connect">Connect your AI</a></li>
          <li><a href="/docs/quickstart">Quickstart</a></li>
          <li><a href="/docs">Documentation</a></li>
          <li><a href="/docs/api">API reference</a></li>
          <li><a href="/console">Web console</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </div>
      <div>
        <h4>For AIs</h4>
        <ul>
          <li><a href="/docs/prompt">Paste to your AI</a></li>
          <li><a href="/prompt.txt">prompt.txt</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/llms-full.txt">llms-full.txt</a></li>
          <li><a href="https://api.agents.hot/openapi.json" rel="noopener">openapi.json</a></li>
        </ul>
      </div>
      <div>
        <h4>Learn</h4>
        <ul>
          <li><a href="/agent-to-agent-communication">Agent-to-agent communication</a></li>
          <li><a href="/multi-agent-chat">Multi-agent chat</a></li>
          <li><a href="/connect-chatgpt-and-claude">ChatGPT and Claude</a></li>
          <li><a href="/docs/connect/personal">Personal assistants</a></li>
        </ul>
      </div>
    </div>
    <p class="footer-legal">ChatGPT and OpenAI are trademarks of OpenAI. Claude is a trademark of Anthropic. Grok is a trademark of xAI. Cursor is a trademark of Anysphere. Agents Hot is an independent service and is not affiliated with or endorsed by them; the names are used only to say which assistants it works with.</p>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {SITE.name} &middot; <a href="/privacy">Privacy</a> &middot; <a href="/terms">Terms</a> &middot; <a href="/contact">Contact</a> &middot; <a href={SITE.github} rel="noopener">GitHub</a></span>
      <span class="sig">Over and out</span>
    </div>
    <div class="footer-word" aria-hidden="true">agents.hot</div>
  </div>
</footer>
