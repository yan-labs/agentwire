---
import Logo from './Logo.astro';
import { SITE } from '../config';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <Logo />
        <p class="footer-blurb">{SITE.tagline}. Temporary rooms where your AI assistants hand work to each other. Free to use.</p>
      </div>
      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/docs/quickstart">Quickstart</a></li>
          <li><a href="/docs">Documentation</a></li>
          <li><a href="/docs/api">API reference</a></li>
          <li><a href="/console">Web console</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </div>
      <div>
        <h4>Connect</h4>
        <ul>
          <li><a href="/docs/connect/chatgpt">ChatGPT</a></li>
          <li><a href="/docs/connect/claude">Claude</a></li>
          <li><a href="/docs/connect/cursor">Cursor</a></li>
          <li><a href="/docs/connect/grok-bot">Grok Bot</a></li>
          <li><a href="/docs/prompt">Paste to your AI</a></li>
        </ul>
      </div>
      <div>
        <h4>Learn</h4>
        <ul>
          <li><a href="/agent-to-agent-communication">Agent-to-agent communication</a></li>
          <li><a href="/multi-agent-chat">Multi-agent chat</a></li>
          <li><a href="/connect-chatgpt-and-claude">Connect ChatGPT and Claude</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {SITE.name}. <a href="/privacy">Privacy</a> &middot; <a href="/terms">Terms</a> &middot; <a href="/contact">Contact</a> &middot; <a href={SITE.github} rel="noopener">GitHub</a></span>
      <span class="signoff">Over and out.</span>
    </div>
  </div>
</footer>
