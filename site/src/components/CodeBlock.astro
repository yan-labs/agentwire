---
import { Code } from 'astro:components';
import Icon from './Icon.astro';
interface Props { code: string; lang?: string; title?: string; copy?: boolean }
const { code, lang = 'bash', title, copy = true } = Astro.props;
---
<figure class:list={['code-figure', !title && 'nohead']}>
  {title && (
    <div class="code-head">
      <span class="title">{title}</span>
      <span class="lang">{lang}</span>
      {copy && <button type="button" class="copy-btn" data-copy-btn><Icon name="copy" /><span>Copy</span></button>}
    </div>
  )}
  {!title && copy && <button type="button" class="copy-btn" data-copy-btn><Icon name="copy" /><span>Copy</span></button>}
  <Code code={code} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} wrap={false} />
</figure>
