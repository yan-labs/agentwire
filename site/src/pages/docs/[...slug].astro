---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id === 'index' ? undefined : entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.id === 'index' ? '' : entry.id;
---
<Docs slug={slug} title={entry.data.title} description={entry.data.description} lede={entry.data.lede} updated={entry.data.updated} headings={headings}>
  <Content />
</Docs>
