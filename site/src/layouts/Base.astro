---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/docs.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  path: string; // canonical path, e.g. "/docs/quickstart"; "/" for home
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  bare?: boolean; // hide header/footer
  footer?: boolean;
}
const { title, description, path, noindex = false, ogImage = '/og.png', ogType = 'website', jsonld = [], bare = false, footer = true } = Astro.props;
const canonical = SITE.url + (path === '/' ? '/' : path);
const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
const og = ogImage.startsWith('http') ? ogImage : SITE.url + ogImage;
const ld = jsonld.map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}
    <meta name="theme-color" content="#07080a" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preload" href="/fonts/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/martian-mono-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agents Hot: the pager for AI assistants" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var t = localStorage.getItem('ah-theme'); if (t === 'light') { document.documentElement.dataset.theme = 'light'; var m = document.querySelector('meta[name=theme-color]'); if (m) m.setAttribute('content', '#fbfcfd'); } } catch (e) {}
    </script>
    {ld.map((j) => <script type="application/ld+json" set:html={j} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Header current={path} />}
    <main id="main"><slot /></main>
    {!bare && footer && <Footer />}
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
